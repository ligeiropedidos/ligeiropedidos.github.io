rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    /* ---- quem e quem ---- */
    function logado() { return request.auth != null; }
    /* e-mail conferido: Google sempre e; o usuario de equipe nasce conferido pelo mensageiro. Quem so se cadastrou com e-mail e senha por fora, nao. */
    function conferido() { return logado() && request.auth.token.email_verified == true; }
    function doisDig(n) { return n < 10 ? '0' + string(n) : string(n); }
    function hojeISO() { return string(request.time.year()) + '-' + doisDig(request.time.month()) + '-' + doisDig(request.time.day()); }
    /* data (AAAA-MM-DD) e data com hora (AAAA-MM-DDTHH) de um instante, em UTC, no formato do toISOString */
    function dataISO(t) { return string(t.year()) + '-' + doisDig(t.month()) + '-' + doisDig(t.day()); }
    function horaISO(t) { return dataISO(t) + 'T' + doisDig(t.hours()); }
    /* senha do dia: datas de Brasilia (UTC-3) que valem agora, com folga de 3 h pra cada lado */
    function diaBaixo() { return dataISO(request.time - duration.value(6, 'h')); }
    function diaAlto() { return dataISO(request.time); }
    function isAdmin() { return conferido() && request.auth.token.email == 'ligeiro.pedidos@gmail.com'; }
    function donoDaLoja(loja) { return get(/databases/$(db)/documents/lojas/$(loja)).data.donoEmail; }
    /* dono: primeiro pela marca "lojas" do login (o mensageiro grava em /dono depois de conferir no banco que a loja e
       dele). Com a marca, a regra nao le a loja: antes cada pedido que andava custava 2 leituras no painel do dono (o
       pedido e a loja). Sem a marca (dono novo, ate o painel abrir), confere lendo a loja, como sempre.
       A marca vence em 3 dias (lojasAte, em segundos) e o painel renova conferindo no banco: dono trocado na mao perde
       a marca sozinho. Para tirar na hora: o admin chama /dono com o e-mail antigo (a marca vira as lojas de hoje). */
    function marcaValendo() { return request.auth.token.get('lojasAte', 0) is number && request.auth.token.get('lojasAte', 0) > request.time.toMillis() / 1000; }
    function isDonoPorMarca(loja) { return conferido() && marcaValendo() && request.auth.token.get('lojas', []) is list && loja in request.auth.token.get('lojas', []); }
    function isDonoDaLoja(loja) { return isDonoPorMarca(loja) || isDonoFirme(loja); }
    /* o que e sensivel (token do Mercado Pago, cupons, vitrine, fotos, relatorios, criar e apagar pedido) confere sempre
       no banco: sao acoes raras, e ali nem uma marca de 3 dias atras vale */
    function isDonoFirme(loja) { return conferido() && request.auth.token.email == donoDaLoja(loja); }
    /* usuario de equipe da loja (cozinha, entregador, balcao): o mensageiro grava a marca {equipe: <loja>} no login
       quando o dono define a senha da equipe. Quem se cadastra sozinho nao consegue essa marca.
       Publique o mensageiro novo ANTES destas regras; depois, cada dono salva a senha da equipe de novo
       (6 numeros), fora do horario de movimento. Ate salvar, a equipe daquela loja fica sem ver os pedidos. */
    /* e o e-mail do nosso dominio: o login velho (equipe.ligeiro.app.br, dominio que nao e nosso) poderia ser tomado pelo
       "esqueci a senha". O dono salva a senha da equipe de novo e o mensageiro passa o login para o e-mail novo */
    function isEquipe(loja) { return logado() && request.auth.token.get('equipe', '') == loja
        && request.auth.token.get('email', '') == 'equipe-' + loja + '@equipe.ligeiropedidos.com.br'; }
    /* login da senha da equipe (qualquer loja): nao cria conta nem loja */
    function ehLoginDeEquipe() { return logado() && request.auth.token.get('equipe', '') != ''; }
    /* a ordem do pedido na fila: a equipe so anda para a frente (cancelar pode a qualquer hora) */
    function ordemDoPedido(s) { return {'aguardando_pagamento': 0, 'pago': 1, 'producao': 2, 'pronto': 3, 'finalizado': 4, 'cancelado': 5}.get(s, -1); }
    function planoDe(d) { return d.get('plano', {}); }
    /* pagoAte vazio: campo ausente, '' ou null valem a mesma coisa */
    function semPago(p) { return p.get('pagoAte', '') == '' || p.get('pagoAte', '') == null; }
    function pagoIgual(a, b) { return a.get('pagoAte', '') == b.get('pagoAte', '') || (semPago(a) && semPago(b)); }
    /* o que so o admin muda no plano: pagoAte, planoPago (o plano que foi pago de fato) e desde (inicio do periodo gratis) */
    function planoDoAdminIntacto(novo, velho) {
      return pagoIgual(novo, velho)
          && novo.get('planoPago', '') == velho.get('planoPago', '')
          /* o preco de fundador: ninguem liga. Desligar so junto com encerrar (os termos: travado enquanto nao cancelar) */
          && (novo.get('fundador', false) == velho.get('fundador', false)
              || (novo.get('fundador', false) == false && novo.get('status', '') == 'cancelado')
              /* copia velha sem o campo (mensageiro de antes de 25/09): a copia do site traz o valor que esta na conta */
              || (!velho.keys().hasAny(['fundador']) && novo.get('fundador', false) == minhaConta().get('plano', {}).get('fundador', false)))
          && novo.get('desde', '') == velho.get('desde', '');
    }
    /* status: o dono so pode manter, encerrar (cancelado) ou reativar (teste); 'ativo' e 'pausado' so o admin */
    function statusPermitido(novo, velho) {
      /* encerrar: de qualquer estado menos pausado (pausa e do admin). Reativar: so quem estava encerrado. */
      return novo.get('status', '') == velho.get('status', '')
          || (novo.get('status', '') == 'cancelado' && velho.get('status', '') != 'pausado')
          || (novo.get('status', '') == 'teste' && velho.get('status', '') == 'cancelado');
    }
    /* LISTA BRANCA do plano: o dono so mexe nestes campos (escolher plano, avisar pagamento, encerrar, reativar).
       Todo o resto (pagoAte, planoPago, fundador, desde, ultimoPagamentoEm, pagamentoParcial, pagamentos...) e do
       admin e dos mensageiros. Antes era lista negra, e campo novo ficava aberto sem ninguem ver */
    function planoSoDoDono(novo, velho) {
      return novo.diff(velho).affectedKeys().hasOnly(['planoId', 'tipo', 'status', 'avisoPagamentoEm', 'avisoValor', 'reativadoEm', 'canceladoEm', 'fundador'])
          /* as datas de encerrar e reativar: texto curto (a data do toISOString), nunca um mapa ou um texto enorme */
          && novo.get('reativadoEm', '') is string && novo.get('reativadoEm', '').size() <= 40
          && novo.get('canceladoEm', '') is string && novo.get('canceladoEm', '').size() <= 40
          && novo.get('tipo', 'mensal') in ['mensal', 'anual']
          /* plano unico: 1 loja por conta. O dono so escolhe o de 1 loja (conta antiga pode ficar no que tinha) */
          && novo.get('avisoValor', 0) is int && novo.get('avisoValor', 0) >= 0 && novo.get('avisoValor', 0) <= 10000000;
    }
    /* Com assinatura viva no Asaas (assinaturaAsaas, que so os mensageiros gravam), trocar de plano e encerrar passam pelo
       mensageiro, que muda a assinatura junto. Mudar direto no banco deixava o cartao cobrando o plano velho, ou cobrando
       depois de encerrar. Reativar (cancelado -> teste) continua livre: nao cobra nada a mais */
    function escolhaPeloMensageiro(novo, velho, conta) {
      return ((conta.get('assinaturaAsaas', '') == '' || conta.get('assinaturaAsaas', '') == null)
              && (conta.get('assinaturaPendente', '') == '' || conta.get('assinaturaPendente', '') == null))
          || (novo.get('planoId', '') == velho.get('planoId', '') && novo.get('tipo', 'mensal') == velho.get('tipo', 'mensal')
              && (novo.get('status', '') == velho.get('status', '') || novo.get('status', '') == 'teste'));
    }
    function planoIntacto() {
      return planoSoDoDono(planoDe(request.resource.data), planoDe(resource.data))
          && planoDoAdminIntacto(planoDe(request.resource.data), planoDe(resource.data))
          && statusPermitido(planoDe(request.resource.data), planoDe(resource.data))
          && request.resource.data.get('ativa', true) == resource.data.get('ativa', true)
          && request.resource.data.get('verificada', false) == resource.data.get('verificada', false)
          && request.resource.data.donoEmail == resource.data.donoEmail;
    }
    /* endereco valido, vagas do Ligeiro e plano copiado da conta: conferidos no mensageiro (/loja-nova), onde a loja nasce */
    function minhaConta() { return get(/databases/$(db)/documents/contas/$(request.auth.token.email)).data; }

    /* conta do dono: a assinatura e daqui. Dono le, escolhe plano, avisa pagamento, encerra e reativa; pagoAte, planoPago, desde e 'ativo' so o admin */
    match /contas/{email} {
      allow read: if isAdmin() || (conferido() && request.auth.token.email == email);
      allow create: if isAdmin() || (conferido() && request.auth.token.email == email && !ehLoginDeEquipe()
        /* so os campos do cadastro, e o plano so com os campos do comeco */
        && request.resource.data.keys().hasOnly(['email', 'nome', 'criadoEm', 'atualizadoEm', 'plano'])
        && planoDe(request.resource.data).keys().hasOnly(['planoId', 'tipo', 'status', 'desde'])
        /* plano unico: a conta nasce no plano de 1 loja, mensal ou anual */
        && planoDe(request.resource.data).get('planoId', 'uma') == 'uma'
        && planoDe(request.resource.data).get('tipo', 'mensal') in ['mensal', 'anual']
        && request.resource.data.get('nome', '') is string && request.resource.data.get('nome', '').size() <= 80
        /* o campo email e o do proprio dono (o e-mail do Ligeiro ali daria cortesia) */
        && request.resource.data.get('email', email) == email
        /* os dias gratis comecam hoje ou antes: ninguem nasce com "desde" no futuro pra ganhar tempo.
           E tem que ser data de verdade (formato do toISOString): lixo virava "gratis pra sempre" */
        && planoDe(request.resource.data).get('desde', '') is string
        && planoDe(request.resource.data).get('desde', '').matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z$')
        /* ate a hora de agora (antes era o dia: dava para ganhar quase um dia a mais de teste), com 1 hora de folga
           para o celular de relogio adiantado ou com o fuso errado (o cadastro era recusado) */
        && planoDe(request.resource.data).get('desde', '')[0:13] <= horaISO(request.time + duration.value(60, 'm'))
        && planoDe(request.resource.data).get('status', 'teste') == 'teste'
        && semPago(planoDe(request.resource.data))
        && planoDe(request.resource.data).get('planoPago', '') == ''
        && planoDe(request.resource.data).get('fundador', false) == false
        && planoDe(request.resource.data).get('ultimoPagamentoEm', '') == '');
      allow update: if isAdmin() || (conferido() && request.auth.token.email == email
        /* LISTA BRANCA: o dono so muda o plano (nos campos dele), o nome e a hora. "pagamentos" (o controle do Asaas de
           pagamento ja contado), "donoEmail" e o resto nao: apagar a lista dava dias de assinatura em dobro */
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plano', 'nome', 'atualizadoEm'])
        /* a hora da mudanca: texto curto (a data do toISOString), como as outras datas */
        && request.resource.data.get('atualizadoEm', '') is string && request.resource.data.get('atualizadoEm', '').size() <= 40
        /* o nome com o mesmo limite do cadastro (antes, na edicao, cabia um texto de 100 mil letras) */
        && request.resource.data.get('nome', '') is string && request.resource.data.get('nome', '').size() <= 80
        && planoSoDoDono(planoDe(request.resource.data), planoDe(resource.data))
        && request.resource.data.get('email', email) == email
        /* plano unico: na conta, o dono so escolhe o de 1 loja (a copia na loja segue a conta, seja qual for) */
        && (planoDe(request.resource.data).get('planoId', 'uma') == planoDe(resource.data).get('planoId', 'uma') || planoDe(request.resource.data).get('planoId', '') == 'uma')
        && planoDoAdminIntacto(planoDe(request.resource.data), planoDe(resource.data))
        && statusPermitido(planoDe(request.resource.data), planoDe(resource.data))
        && escolhaPeloMensageiro(planoDe(request.resource.data), planoDe(resource.data), resource.data)
        /* ultimo pagamento decide se a conta ainda ganha o preco de fundador: so o admin mexe */
        && planoDe(request.resource.data).get('ultimoPagamentoEm', '') == planoDe(resource.data).get('ultimoPagamentoEm', ''));
      allow delete: if isAdmin();
    }

    /* vitrine: resumo leve de cada loja pro hub e pra pagina das cidades (publico).
       O dono grava DEPOIS da loja (nunca no mesmo lote) e o plano/ativa tem que ser copia do que esta na loja. */
    match /vitrine/{loja} {
      allow read: if true;
      allow create, update: if isAdmin() || (isDonoFirme(loja)
        /* resumo sem e-mail: o e-mail do Ligeiro aqui daria cortesia no hub */
        && !request.resource.data.keys().hasAny(['email', 'donoEmail'])
        /* o resumo e da propria loja e com os tipos que o site le (um horario torto derrubava a pagina das cidades) */
        && request.resource.data.get('slug', loja) == loja
        && request.resource.data.get('nome', '') is string && request.resource.data.get('nome', '').size() <= 80
        && request.resource.data.get('cidadeSlug', '') is string && request.resource.data.get('cidadeSlug', '').matches('^[a-z0-9-]{0,60}$')
        && request.resource.data.get('horarios', {}) is map
        && request.resource.data.size() <= 60
        && planoDe(request.resource.data) == planoDe(get(/databases/$(db)/documents/lojas/$(loja)).data)
        && request.resource.data.get('ativa', true) == get(/databases/$(db)/documents/lojas/$(loja)).data.get('ativa', true)
        && request.resource.data.get('verificada', false) == get(/databases/$(db)/documents/lojas/$(loja)).data.get('verificada', false));
      allow delete: if isAdmin();
    }

    /* numeros publicos do Ligeiro (vagas de fundador ocupadas): todo mundo le, so o admin escreve */
    match /publico/{doc} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    /* indice order -> loja/pedido, gravado pelo mensageiro (conta de servico); ninguem do site precisa ler */
    match /mp_indice/{id} {
      allow read, write: if isAdmin();
    }

    /* contatos da pagina de vendas: nascem no mensageiro (/lead, com limite por aparelho e por dia). Direto do site, um robo
       mandando milhares gastava a cota de gravacoes do dia (a mesma dos pedidos). So o admin le e marca como atendido.
       A regra de criar fica para o admin (e como referencia do formato que o mensageiro grava) */
    match /leads/{id} {
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['id', 'nome', 'whatsapp', 'loja', 'cidade', 'uf', 'origem', 'pagina', 'criadoEm', 'atendidoEm'])
                    && request.resource.data.keys().hasAll(['nome', 'whatsapp', 'criadoEm'])
                    && request.resource.data.nome is string && request.resource.data.nome.size() <= 60
                    && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 16
                    && request.resource.data.get('loja', '') is string && request.resource.data.get('loja', '').size() <= 80
                    && request.resource.data.get('cidade', '') is string && request.resource.data.get('cidade', '').size() <= 80
                    && request.resource.data.get('pagina', '') is string && request.resource.data.get('pagina', '').size() <= 200
                    && request.resource.data.get('uf', '') is string && request.resource.data.get('uf', '').size() <= 2
                    && request.resource.data.get('origem', '') is string && request.resource.data.get('origem', '').size() <= 40
                    /* nasce do jeito que o formulario manda: id igual ao do documento e ainda nao atendido */
                    && request.resource.data.get('id', id) == id
                    && request.resource.data.get('atendidoEm', '') == ''
                    /* criadoEm e data e hora de verdade, sem ir pro futuro (senao fica pra sempre no topo da lista do admin) */
                    && request.resource.data.criadoEm is string
                    && request.resource.data.criadoEm.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z$')
                    && request.resource.data.criadoEm[0:13] <= horaISO(request.time + duration.value(3, 'h'));
      allow read, update, delete: if isAdmin();
    }

    /* cardapio com tamanho de gente: ate 20 categorias e 300 itens (os mesmos numeros de config.limites no site).
       Na edicao so confere quando o campo muda: loja que ja tivesse mais continua salvando o resto */
    function cardapioNoLimite() {
      return (!('categorias' in request.resource.data) || request.resource.data.categorias.size() <= 20)
        && (!('produtos' in request.resource.data) || request.resource.data.produtos.size() <= 300)
        /* grupos so como mapa (em lista, o limite de 30 era pulado) */
        && (!('grupos' in request.resource.data) || (request.resource.data.grupos is map && request.resource.data.grupos.size() <= 30));
    }

    match /lojas/{loja} {
      /* cada loja e publica pelo endereco (o site do cliente le); a lista inteira nao:
         so o admin, e o dono listando as proprias (listarMinhasLojas filtra por donoEmail) */
      /* os cupons ficam na parte privada (privado/cupons); o documento publico so diz "temCupom". A regra do update
         nao deixa uma lista de cupons voltar para ca (qualquer um le este documento) */
      allow get: if true;
      allow list: if isAdmin() || (conferido() && resource.data.donoEmail == request.auth.token.email);
      /* loja nova nasce no mensageiro (/loja-nova, conta de servico): ele confere o limite do plano da conta, as vagas do
         Ligeiro e o endereco livre (sem sobra de loja apagada). Direto do site, qualquer conta conferida criava lojas sem
         fim (so o admin, pela Central) */
      allow create: if isAdmin();
      allow update: if isAdmin() || (conferido() && request.auth.token.email == resource.data.donoEmail && planoIntacto()
        /* o slug e o endereco: uma loja nao se passa por outra (trocar o slug abria a pagina com o tema e o selo da outra) */
        && request.resource.data.get('slug', loja) == loja
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
        /* cupom nunca no documento publico: so apagar a lista antiga (vazia ou sem o campo) */
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['cupons']) || !(request.resource.data.get('cupons', []) is list) || request.resource.data.get('cupons', []).size() == 0)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['categorias', 'produtos', 'grupos']) || cardapioNoLimite()));
      allow delete: if isAdmin();

      /* senha do dia e usos de cupom: quem grava e o mensageiro (conta de servico), junto com o pedido, no mesmo lote.
         O dono e o admin corrigem se precisar. Ninguem de fora le (a lista mostrava os codigos de cupom) nem grava
         (dava para queimar o cupom da loja, repetir senha ou travar os pedidos gravando sem parar) */
      match /contadores/{c} {
        allow get: if isEquipe(loja) || isDonoDaLoja(loja) || isAdmin();
        allow list, write: if isDonoFirme(loja) || isAdmin();
      }
      /* vendas de cada dia que ja fechou (o relatorio de 30 dias le 30 resumos, nao os pedidos do mes): so o dono e o admin */
      match /resumos/{dia} {
        allow read, write: if isDonoFirme(loja) || isAdmin();
      }
      match /fotos/{foto} {
        allow read: if true;
        allow write: if isDonoFirme(loja) || isAdmin();
      }
      /* token do Mercado Pago e outros segredos: so o dono (e o admin, pra suporte) */
      match /privado/{doc} {
        allow read, delete: if isDonoFirme(loja) || isAdmin();
        /* cupons: ate 20 por loja (o painel avisa antes; aqui ninguem passa por fora) */
        allow create, update: if isAdmin() || (isDonoFirme(loja)
          && (doc != 'cupons' || (request.resource.data.get('lista', []) is list && request.resource.data.get('lista', []).size() <= 20)));
      }
      match /pedidos/{pedido} {
        /* O PEDIDO NASCE NO MENSAGEIRO (rota /pedido, conta de servico, que passa por cima destas regras): ele monta o
           pedido com as regras do site e o cardapio, da a senha e conta o cupom. Gravado direto pelo celular, nao:
           era por aqui que dava para criar pedido de graca, com cupom inventado, com o nome de uma pizza e o preco de uma
           agua, em loja fechada ou com forma de pagamento desligada. So o dono (na propria loja) e o admin gravam direto */
        allow create: if isAdmin() || isDonoFirme(loja);
        /* o cliente acompanha pelo id (ninguem adivinha). Nome, telefone e endereco ficam abertos so por 3 dias: link
           vazado depois disso nao mostra mais nada */
        allow get: if resource.data.get('criadoEm', '') >= dataISO(request.time - duration.value(3, 'd'))
                   || isEquipe(loja) || isDonoDaLoja(loja) || isAdmin();
        /* a equipe vem primeiro: ela se reconhece pela marca do login, sem ler a loja (isDonoDaLoja le a loja inteira,
           e a leitura conta no plano gratis a cada toque da cozinha e do entregador) */
        /* a loja e a equipe dela listam a fila; a equipe sempre com limite (nunca o historico inteiro de clientes) */
        /* a equipe (senha de 6 numeros, compartilhada) ve so a fila e os pedidos dos ultimos 2 dias: paginando, antes ela
           chegava ao historico inteiro de clientes (nome, telefone, endereco) */
        allow list: if isAdmin() || isDonoDaLoja(loja) || (isEquipe(loja) && request.query.limit <= 300
          && (resource.data.status in ['aguardando_pagamento', 'pago', 'producao', 'pronto']
              || resource.data.criadoEm >= dataISO(request.time - duration.value(2, 'd'))));
        allow update: if
          /* equipe (cozinha, entregador, painel com a senha da equipe): so anda com o pedido, nunca mexe em valor, itens ou cliente */
          (isEquipe(loja) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'pagamentoStatus', 'pagoEm', 'canceladoPor', 'atualizadoEm'])
              && request.resource.data.status in ['aguardando_pagamento', 'pago', 'producao', 'pronto', 'finalizado', 'cancelado']
              /* pedido cancelado ou concluido nao volta (nem um cancelado e devolvido vira "pago" de novo) */
              && (!(resource.data.status in ['cancelado', 'finalizado']) || request.resource.data.status == resource.data.status)
              /* cancelado e devolvido nao volta a "pago" pela mao da equipe (reaparecia em "Falta devolver") */
              && (resource.data.status != 'cancelado' || request.resource.data.get('pagamentoStatus', '') == resource.data.get('pagamentoStatus', ''))
              /* so para a frente: um toque de tela velha ou feito sem internet nao puxa o pedido de volta (pronto -> producao) */
              && (request.resource.data.status == 'cancelado' || ordemDoPedido(request.resource.data.status) >= ordemDoPedido(resource.data.status))
              /* Pix e cartao pelo Mercado Pago: quem confirma e o mensageiro, com o banco. A equipe nao marca como pago (print
                 falso nao libera pedido) */
              && !(resource.data.get('mp', null) != null && resource.data.status == 'aguardando_pagamento'
                   && (request.resource.data.status == 'pago' || request.resource.data.get('pagamentoStatus', '') == 'pago')))
          || isDonoDaLoja(loja) || isAdmin()
          /* (o "ja paguei" do cliente saiu: o Pix confirma sozinho e o aviso deixava o pedido laranja, "Diz que pagou", com
             qualquer print) */
          /* cliente: cancelar o proprio pedido enquanto ainda esta aguardando o Pix (nunca com o cartao em analise no banco:
             ele pode passar depois, e o cliente pagaria de novo por outro pedido) */
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'canceladoPor', 'atualizadoEm'])
              && request.resource.data.status == 'cancelado' && request.resource.data.canceladoPor in ['cliente', 'pix-vencido']
              && resource.data.status == 'aguardando_pagamento' && resource.data.get('cobrancaIncerta', '') == ''
              && request.resource.data.get('atualizadoEm', '') is string && request.resource.data.get('atualizadoEm', '').size() <= 30);
        /* o dono apaga pedido cancelado (lixo gravado por fora, teste); o resto, so o admin */
        allow delete: if isAdmin() || (isDonoFirme(loja) && resource.data.status == 'cancelado');
      }
    }
  }
}
